[Unit]
Description=Hyprneuro independent local observational sidecar
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Starts with event ingestion disabled. Enable only after explicitly opting in.
# Installer replaces ExecStart with the absolute executable path and opted-in flags.
ExecStart=%h/.local/share/hyprneuro/venv/bin/hyprneuro serve
Environment=PATH=%h/.bin:%h/.local/bin:/usr/bin
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
# AF_INET is necessary for opt-in D1/Omni capture or D1 alert scoring.
# Model URLs are hardcoded to 127.0.0.1; no remote model traffic is requested.
RestrictAddressFamilies=AF_UNIX AF_INET

[Install]
WantedBy=graphical-session.target
